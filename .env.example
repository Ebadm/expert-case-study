# Copy to .env and fill in the three API keys. Never commit real keys.
# Every other value below is the default; delete a line or leave it blank to use it.
# Each setting is explained here; ARCHITECTURE.md section 8 has the same list as a table.

# --------------------------------------------------------------------------- #
# API keys
# --------------------------------------------------------------------------- #
ANTHROPIC_API_KEY=
SERPER_API_KEY=
EXA_API_KEY=

# --------------------------------------------------------------------------- #
# Prices, for the cost figures in run_metadata.json (not in the code).
# A blank price makes that cost "unknown" ($?) instead of a guess.
# Exa reports its own cost per request, so it needs no price here.
# --------------------------------------------------------------------------- #
# Anthropic, USD per million tokens for LLM_MODEL. Claude Haiku 5.5 list prices
# (prompts up to 100K tokens; $0.50 / $2.50 beyond). Update when the model changes.
LLM_PRICE_IN_PER_MTOK=0.10
LLM_PRICE_OUT_PER_MTOK=0.50
LLM_PRICES_AS_OF=2026-10-06
# Serper, USD per 1,000 credits (1 credit = 1 Google results page). $1 / 1,000 is the
# entry-level credit pack; use your plan's rate.
SERPER_PRICE_PER_1K=1.0

# --------------------------------------------------------------------------- #
# LLM
# --------------------------------------------------------------------------- #
LLM_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max
LLM_EFFORT=medium

# --------------------------------------------------------------------------- #
# Search: how much to search
# --------------------------------------------------------------------------- #
# Qualified candidates per group (passed verification and the LLM's check against the
# group's hard requirements: the final list's own test) after which the agent stops
# enriching, skips the Exa people top-up and the remaining stage-5 batches. The final
# list has 20; 25 leaves a margin. 0 disables early stopping.
TARGET_CANDIDATES_PER_GROUP=25
# false: count candidates whose dates fit instead (no LLM calls while searching).
QUALIFY_WITH_LLM=true
# Max Exa queries and company-discovery queries per expert group, per provider (1-20).
QUERIES_PER_PROVIDER=5
# Max Google LinkedIn X-ray queries per expert group (1-30). Google returns ~10 profiles
# per filtered X-ray, so former-employee recall needs more slices (~2 credits each).
XRAY_QUERIES_PER_GROUP=20
# Organisations found by company discovery (e.g. the target's customers) searched
# for people, one Google X-ray each, best-evidenced first (0-200).
ORG_PEOPLE_QUERIES_PER_GROUP=40
# People named on web pages (case studies, press releases) whose LinkedIn profile is
# looked up, per group: up to three Google queries each (~$0.002 per person). 0 = off.
PROFILE_LOOKUPS_PER_GROUP=60

# --------------------------------------------------------------------------- #
# Search: providers
# --------------------------------------------------------------------------- #
# Serper (Google): result pages per company query (10 results and 1 credit each, max 10).
SERPER_MAX_PAGES=10
# Most Google pages per LinkedIn X-ray. With a target, page 1 is fetched first; later
# pages are fetched one at a time, only for groups that read everything and are still short.
SERPER_PEOPLE_MAX_PAGES=3
# Exa: results per query (one request each, max 100) and page text kept per result.
EXA_NUM_RESULTS=50
EXA_TEXT_MAX_CHARS=4000
# Exa search type per query type: instant | fast | auto | deep-lite | deep | deep-reasoning.
# On people search "auto" returned more real matches than "deep" (ARCHITECTURE.md 4.3).
EXA_PEOPLE_SEARCH_TYPE=auto
EXA_COMPANY_SEARCH_TYPE=deep

# --------------------------------------------------------------------------- #
# Candidate extraction
# --------------------------------------------------------------------------- #
# Hard cap on company-discovery pages the LLM reads per group (best-ranked first);
# reading stops earlier once the group has ORG_PEOPLE_QUERIES_PER_GROUP organisations.
EXTRACTION_MAX_PAGES_PER_GROUP=150
# Profiles/pages enriched and read between early-stop checks.
EXTRACTION_BATCH_SIZE=50
# Parallel LLM calls (8 stays under 80k output tokens/minute on Haiku).
EXTRACTION_LLM_WORKERS=8
# Fetch page/profile content for Serper results through Exa /contents (~$0.001/page).
EXTRACTION_ENRICH=true

# --------------------------------------------------------------------------- #
# Shortlist (entity resolution, verification, ranking)
# --------------------------------------------------------------------------- #
# Experts returned per group (fewer if fewer qualify; the list is never padded).
MAX_EXPERTS_PER_GROUP=20
# New LLM verdicts per group at ranking (best code-scored first); candidates already
# judged while searching or by an earlier run are always ranked as well.
RANK_POOL_PER_GROUP=60
# Ranking weight overrides, e.g. role_fit=0.3,recency=0.1 (others keep the defaults
# role_fit 0.25, relevance 0.2, evidence_strength 0.25, recency 0.15, corroboration 0.1,
# seniority 0.05; renormalised to 1). Blank = defaults.
RANK_WEIGHTS=
# Points (of 100) taken off an expert with no profile URL (named only on a web page and
# profile lookup found none), so experts with a profile rank first. 0 = off.
NO_PROFILE_PENALTY=25
# Ambiguous identity pairs (two profiles, near names, shared employer) the LLM may judge.
MAX_IDENTITY_LLM_PAIRS=40
